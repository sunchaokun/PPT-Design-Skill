{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-design-skill.local/schemas/acceptance-record.schema.json",
  "title": "Acceptance Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "target_id", "criteria", "score", "reviewer", "evidence", "status"],
  "properties": {
    "record_id": { "type": "string", "minLength": 1 },
    "target_id": { "type": "string", "minLength": 1 },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "score", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "score": { "type": "integer", "minimum": 0, "maximum": 2 },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "score": { "type": "number", "minimum": 0, "maximum": 12 },
    "reviewer": { "type": "string", "minLength": 1 },
    "second_reviewer": { "type": "string" },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["PASS", "NEEDS_REVISION", "BLOCKED"] },
    "revision_record": { "type": "string" },
    "extensions": { "type": "object" }
  }
}
