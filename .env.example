# Copy this file to .env in the presentation project that runs build.py.
# Never commit .env or place secrets in the installed skill directory.
# pptx-designer loads the nearest project .env; process variables take priority.

# Recommended: explicit provider configuration for generated images.
# Supported providers: gpt-image, seedream, gemini, wanx, kimi.
PPT_IMAGE_LLM_PROVIDER=gpt-image
OPENAI_API_KEY=replace-with-your-api-key
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Alternative providers — enable one block and set its key.
# PPT_IMAGE_LLM_PROVIDER=seedream
# ARK_API_KEY=replace-with-your-ark-api-key
# ARK_IMAGE_MODEL=
# ARK_BASE_URL=

# PPT_IMAGE_LLM_PROVIDER=gemini
# GEMINI_API_KEY=replace-with-your-gemini-api-key
# GEMINI_IMAGE_MODEL=
# GEMINI_BASE_URL=

# PPT_IMAGE_LLM_PROVIDER=wanx
# DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
# DASHSCOPE_IMAGE_MODEL=
# DASHSCOPE_BASE_URL=

# Generic OpenAI-compatible endpoint.
# PPT_IMAGE_LLM_PROVIDER=gpt-image
# PPT_IMAGE_LLM_API_KEY=replace-with-your-api-key
# PPT_IMAGE_LLM_BASE_URL=https://your-compatible-endpoint/v1
# PPT_IMAGE_LLM_MODEL=your-image-model

# Optional stock-image search providers.
# UNSPLASH_ACCESS_KEY=
# PEXELS_API_KEY=
